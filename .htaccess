# ══════════════════════════════════════════════════════════
#  Root security hardening — Apache 2.4+
# ══════════════════════════════════════════════════════════

# ── Disable directory listing ──────────────────────────────
Options -Indexes

# ── Block known attacker IPs ──────────────────────────────
# POST flood: 182.62.150.241, 115.164.218.61
<RequireAll>
    Require all granted
    Require not ip 182.62.150.241
    Require not ip 115.164.218.61
</RequireAll>

# ── Reject abnormally large POST bodies at the Apache level ─
# Legitimate photo submissions are base64 JPEG ≤ ~2 MB encoded.
# Attackers were sending 1.7–1.8 MB raw; cap at 3 MB to be safe.
<IfModule mod_env.c>
    SetEnvIf Content-Length [0-9]{8,} LARGE_PAYLOAD
</IfModule>
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{ENV:LARGE_PAYLOAD} 1
    RewriteCond %{REQUEST_URI} ^/save\.php [NC]
    RewriteRule ^ - [F,L]
</IfModule>

# ── Connection / request throttle (mod_reqtimeout) ────────
# Drop connections that are slow to send headers (slowloris)
<IfModule mod_reqtimeout.c>
    RequestReadTimeout header=20-40,MinRate=500 body=20-120,MinRate=500
</IfModule>

# ── Block access to sensitive files ───────────────────────
<FilesMatch "(\.git|\.gitignore|\.env|\.htpasswd|composer\.lock|^auth\.php)$">
    Require all denied
</FilesMatch>

# Block the entire .git directory
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^\.git(/.*)?$ - [F,L]
</IfModule>

# ── Security response headers ──────────────────────────────
<IfModule mod_headers.c>
    # Prevent MIME-type sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Deny embedding in iframes (clickjacking protection)
    Header always set X-Frame-Options "DENY"

    # Control referrer leakage
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Restrict browser features
    Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=()"

    # Content Security Policy
    # - scripts: only same-origin files (no inline scripts)
    # - styles: same-origin + Google Fonts + inline (PHP files embed <style>)
    # - images: same-origin + data URIs (canvas toDataURL)
    # - fonts: Google Fonts CDN only
    # - connect: same-origin only (fetch → save.php)
    # - frame-ancestors: deny embedding anywhere
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"

    # Remove server banner header leakage
    Header always unset X-Powered-By
    Header always unset Server
</IfModule>

# ── Force HTTPS (uncomment when your server has a valid SSL cert) ──
# <IfModule mod_rewrite.c>
#     RewriteEngine On
#     RewriteCond %{HTTPS} off
#     RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
# </IfModule>

# ── Limit HTTP methods ─────────────────────────────────────
# Only GET, POST, HEAD are needed by this app
<LimitExcept GET POST HEAD>
    Require all denied
</LimitExcept>
